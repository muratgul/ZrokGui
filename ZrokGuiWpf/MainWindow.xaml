<Window x:Class="ZrokGuiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Zrok GUI" Height="760" Width="1050"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- Spacing and standard margins -->
        <Thickness x:Key="StandardMargin">0,0,0,16</Thickness>
        <Thickness x:Key="CardPadding">32</Thickness>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="{StaticResource StandardMargin}"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Margin" Value="{StaticResource StandardMargin}"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="{StaticResource StandardMargin}"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConsoleOutput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" BorderThickness="1" BorderBrush="#E0E0E0">
        <materialDesign:DialogHost x:Name="RootDialog" DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <Grid>
                    <!-- HELP DIALOG -->
                    <Grid x:Name="HelpDialogContainer" Width="450" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtHelpTitle" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtHelpContent" TextWrapping="Wrap" FontSize="15" Opacity="0.85" LineHeight="24"/>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="GOT IT" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" HorizontalAlignment="Right" Margin="0,24,0,0"/>
                    </Grid>

                    <!-- ZROK MISSING DIALOG -->
                    <Grid x:Name="ZrokMissingDialogContainer" Width="450" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E53935" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Zrok is Not Installed!" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#E53935"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="15" Opacity="0.85" LineHeight="24">
                            <Run Text="ZrokGui is a graphical interface for the "/>
                            <Run FontWeight="Bold" Text="zrok"/>
                            <Run Text=" engine, but 'zrok.exe' was not found on your system."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="Please download the latest release of zrok, extract it, and either add it to your system PATH or simply place "/>
                            <Run FontWeight="SemiBold" Text="'zrok.exe'"/>
                            <Run Text=" in the same folder as this application."/>
                        </TextBlock>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Content="DOWNLOAD ZROK" Click="BtnDownloadZrok_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <Button Content="I FIXED IT (RETRY)" Click="BtnRetryZrok_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        <!-- Overall layout: Top Header, Left Sidebar, Right Content -->
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16,12,12,16" materialDesign:ElevationAssist.Elevation="Dp4" Background="#FFDEDEDD" MouseDown="ColorZone_MouseDown" CornerRadius="12,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CloudUploadOutline" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"><Run Text="Zrok"/><Run Language="tr-tr" Text="Gui"/></TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="14" Margin="24,0,0,0" Opacity="0.8" Text="Secure Tunneling &amp; Sharing" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                    
                    <Border x:Name="ZrokStatusBadge" Background="#FF757575" CornerRadius="12" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="ZrokStatusIcon" Kind="ClockOutline" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtZrokStatus" Text="Checking zrok..." FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Click="BtnMinimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="40" Height="40" Padding="0" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20" />
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="40" Height="40" Padding="0" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="20" Height="20" />
                    </Button>
                    <Button Click="BtnClose_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="40" Height="40" Padding="0">
                        <materialDesign:PackIcon Kind="WindowClose" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1" Background="#F0F2F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- WIDE SIDEBAR -->
            <materialDesign:Card Grid.Column="0" Margin="0" UniformCornerRadius="0" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
                <ListBox x:Name="SidebarMenu" SelectedIndex="{Binding ElementName=MainTabControl, Path=SelectedIndex}" Margin="0,16,0,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="Margin" Value="12,4"/>
                            <Setter Property="materialDesign:ListBoxItemAssist.CornerRadius" Value="8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Public Share" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Private Share" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderNetworkOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="File Server" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Reserved Shares" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </materialDesign:Card>

            <!-- CONTENT AREA -->
            <TabControl x:Name="MainTabControl" 
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                
                <!-- PUBLIC SHARE -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,16">
                            <materialDesign:PackIcon Kind="Web" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Public Share" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <materialDesign:Card Padding="{StaticResource CardPadding}" UniformCornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Public Web Share" Style="{StaticResource TitleText}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnHelpPublic_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Margin="0,-4,0,0" ToolTip="Help &amp; Guide">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="24" Height="24" Opacity="0.6"/>
                                    </Button>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtPublicTarget" materialDesign:HintAssist.Hint="Target Endpoint (e.g. 8080 or C:\path)"/>
                                    
                                    <ComboBox x:Name="cmbPublicBackend" Grid.Column="2" materialDesign:HintAssist.Hint="Backend Mode">
                                        <ComboBoxItem Content="proxy" IsSelected="True"/>
                                        <ComboBoxItem Content="web"/>
                                        <ComboBoxItem Content="caddy"/>
                                        <ComboBoxItem Content="drive"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Margin="0,8,0,24" Background="#E0E0E0"/>

                                <TextBlock Text="Security Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Opacity="0.7"/>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Basic Auth" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                                        <ToggleButton x:Name="chkPublicAuth" Checked="ChkPublicAuth_CheckedChanged" Unchecked="ChkPublicAuth_CheckedChanged" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                    </StackPanel>

                                    <TextBox x:Name="txtPublicUsername" Grid.Column="2" materialDesign:HintAssist.Hint="Username" IsEnabled="False" Margin="0"/>
                                    <PasswordBox x:Name="txtPublicPassword" Grid.Column="4" materialDesign:HintAssist.Hint="Password" IsEnabled="False" Margin="0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button x:Name="btnPublicStop" Content="STOP SHARING" Style="{StaticResource StopButton}" IsEnabled="False" Click="BtnStop_Click" Margin="0,0,12,0"/>
                                    <Button x:Name="btnPublicShare" Content="START SHARE" Click="BtnPublicShare_Click" Width="160"  Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Output Card -->
                        <materialDesign:Card Grid.Row="1" Margin="0,24,0,0" UniformCornerRadius="8">
                            <TextBox x:Name="txtPublicOutput" Style="{StaticResource ConsoleOutput}" Margin="0" BorderThickness="0" materialDesign:HintAssist.Hint="Waiting for share..." Padding="16"/>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- PRIVATE SHARE -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,16">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Private Share" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <materialDesign:Card Padding="{StaticResource CardPadding}" UniformCornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Private Encrypted Share" Style="{StaticResource TitleText}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnHelpPrivate_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Margin="0,-4,0,0" ToolTip="Help &amp; Guide">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="24" Height="24" Opacity="0.6"/>
                                    </Button>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtPrivateTarget" materialDesign:HintAssist.Hint="Target Endpoint (e.g. 8080)"/>
                                    
                                    <ComboBox x:Name="cmbPrivateBackend" Grid.Column="2" materialDesign:HintAssist.Hint="Backend Mode">
                                        <ComboBoxItem Content="proxy" IsSelected="True"/>
                                        <ComboBoxItem Content="web"/>
                                        <ComboBoxItem Content="caddy"/>
                                        <ComboBoxItem Content="drive"/>
                                        <ComboBoxItem Content="tcpTunnel"/>
                                        <ComboBoxItem Content="udpTunnel"/>
                                        <ComboBoxItem Content="socks"/>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button x:Name="btnPrivateStop" Content="STOP SHARING" Style="{StaticResource StopButton}" IsEnabled="False" Click="BtnStop_Click" Margin="0,0,12,0"/>
                                    <Button x:Name="btnPrivateShare" Content="START SHARE" Click="BtnPrivateShare_Click" Width="160" Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Output Card -->
                        <materialDesign:Card Grid.Row="1" Margin="0,24,0,0" UniformCornerRadius="8">
                            <TextBox x:Name="txtPrivateOutput" Style="{StaticResource ConsoleOutput}" Margin="0" BorderThickness="0" materialDesign:HintAssist.Hint="Waiting for share..." Padding="16"/>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- FILE SHARE -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,16">
                            <materialDesign:PackIcon Kind="FolderNetworkOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="File Server" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <materialDesign:Card Padding="{StaticResource CardPadding}" UniformCornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Local Directory Sharing" Style="{StaticResource TitleText}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnHelpFile_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Margin="0,-4,0,0" ToolTip="Help &amp; Guide">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="24" Height="24" Opacity="0.6"/>
                                    </Button>
                                </Grid>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtFilePath" materialDesign:HintAssist.Hint="Select Folder Path" Margin="0"/>
                                    <Button Grid.Column="2" Content="BROWSE" Click="BtnBrowseFolder_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="48" materialDesign:ButtonAssist.CornerRadius="6"/>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Network Type" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" Opacity="0.7"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="rbFilePublic" Content="Public Network" IsChecked="True" Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,24,0"/>
                                            <RadioButton x:Name="rbFilePrivate" Content="Private Network" Style="{StaticResource MaterialDesignRadioButton}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ComboBox x:Name="cmbFileMode" Grid.Column="2" materialDesign:HintAssist.Hint="Backend Mode" VerticalAlignment="Bottom">
                                        <ComboBoxItem Content="web" IsSelected="True"/>
                                        <ComboBoxItem Content="drive"/>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
                                    <Button x:Name="btnFileStop" Content="STOP SERVER" Style="{StaticResource StopButton}" IsEnabled="False" Click="BtnStop_Click" Margin="0,0,12,0"/>
                                    <Button x:Name="btnFileShare" Content="START SERVER" Click="BtnFileShare_Click" Width="160" Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Output Card -->
                        <materialDesign:Card Grid.Row="1" Margin="0,24,0,0" UniformCornerRadius="8">
                            <TextBox x:Name="txtFileOutput" Style="{StaticResource ConsoleOutput}" Margin="0" BorderThickness="0" materialDesign:HintAssist.Hint="Waiting for share..." Padding="16"/>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- RESERVED SHARES -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,16">
                            <materialDesign:PackIcon Kind="TagOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Reserved Shares" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <materialDesign:Card Padding="{StaticResource CardPadding}" UniformCornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Reserve &amp; Manage Static Endpoints" Style="{StaticResource TitleText}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnHelpReserve_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Margin="0,-4,0,0" ToolTip="Help &amp; Guide">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="24" Height="24" Opacity="0.6"/>
                                    </Button>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtReserveTarget" Grid.Column="0" materialDesign:HintAssist.Hint="Target Endpoint" Margin="0"/>
                                    
                                    <ComboBox x:Name="cmbReserveType" Grid.Column="2" materialDesign:HintAssist.Hint="Share Type" Margin="0">
                                        <ComboBoxItem Content="public" IsSelected="True"/>
                                        <ComboBoxItem Content="private"/>
                                    </ComboBox>
                                    
                                    <ComboBox x:Name="cmbReserveBackend" Grid.Column="4" materialDesign:HintAssist.Hint="Backend Mode" Margin="0">
                                        <ComboBoxItem Content="proxy" IsSelected="True"/>
                                        <ComboBoxItem Content="web"/>
                                        <ComboBoxItem Content="tcpTunnel"/>
                                    </ComboBox>
                                    
                                    <Button x:Name="btnCreateReserve" Grid.Column="6" Content="CREATE RESERVE" Click="BtnCreateReserve_Click" Height="48" Width="160" Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- List Card -->
                        <materialDesign:Card Grid.Row="1" Margin="0,24,0,24" UniformCornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <ListView x:Name="lvReservedShares" Style="{StaticResource MaterialDesignListView}" BorderThickness="0" Margin="0,0,0,16">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Reserved Token" DisplayMemberBinding="{Binding Token}" Width="180"/>
                                            <GridViewColumn Header="Backend" DisplayMemberBinding="{Binding Backend}" Width="120"/>
                                            <GridViewColumn Header="Target Endpoint" DisplayMemberBinding="{Binding Target}" Width="300"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnRefreshReserves" Content="REFRESH" Click="BtnRefreshReserves_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" materialDesign:ButtonAssist.CornerRadius="6" Margin="0,0,12,0"/>
                                    <Button x:Name="btnDeleteReserve" Content="DELETE SELECTED" Click="BtnDeleteReserve_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" materialDesign:ButtonAssist.CornerRadius="6" Foreground="#FB8C00" BorderBrush="#FB8C00" Margin="0,0,24,0"/>
                                    
                                    <Button x:Name="btnStopReserved" Content="STOP" Click="BtnStop_Click" IsEnabled="False" Style="{StaticResource StopButton}" Height="36" Margin="0,0,12,0"/>
                                    <Button x:Name="btnStartReserved" Content="START SELECTED" Click="BtnStartReserved_Click" Width="160" Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Output Card -->
                        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8">
                            <TextBox x:Name="txtReserveOutput" Style="{StaticResource ConsoleOutput}" Margin="0" BorderThickness="0" materialDesign:HintAssist.Hint="Reserved operations output..." Padding="16"/>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- SETTINGS -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,16">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <materialDesign:Card Padding="{StaticResource CardPadding}" UniformCornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Environment Status" Style="{StaticResource TitleText}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnHelpSettings_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Margin="0,-4,0,0" ToolTip="Help &amp; Guide">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="24" Height="24" Opacity="0.6"/>
                                    </Button>
                                </Grid>
                                
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtEnableToken" Grid.Column="0" materialDesign:HintAssist.Hint="Paste zrok account token here" Margin="0"/>
                                    <Button x:Name="btnEnable" Grid.Column="2" Content="ENABLE ACCOUNT" Click="BtnEnable_Click" Height="48" Background="#FF547788" Foreground="White" BorderBrush="{x:Null}"/>
                                </Grid>

                                <Separator Margin="0,8,0,24" Background="#E0E0E0"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnStatus" Content="CHECK NETWORK STATUS" Click="BtnStatus_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="42" materialDesign:ButtonAssist.CornerRadius="6" Width="240"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Output Card -->
                        <materialDesign:Card Grid.Row="1" Margin="0,24,0,0" UniformCornerRadius="8">
                            <TextBox x:Name="txtStatusOutput" Style="{StaticResource ConsoleOutput}" Margin="0" BorderThickness="0" materialDesign:HintAssist.Hint="System status output..." Padding="16"/>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

            </TabControl>
            </Grid>
        </Grid>
        </materialDesign:DialogHost>
    </Border>
</Window>
